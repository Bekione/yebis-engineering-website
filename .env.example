# ==============================================================================
# YEBIS ENGINEERING - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Add these variables to your Vercel Project Settings (Settings -> Environment Variables)
# or your production host environment.

# ------------------------------------------------------------------------------
# 1. PRIMARY EMAIL PROVIDER: RESEND (RECOMMENDED FOR VERCEL & NEXT.JS)
# ------------------------------------------------------------------------------
# Create a free account at https://resend.com (3,000 emails/month free)
# Generate an API key at https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key_here"

# Sender Address
# Before domain verification, you can test with: "Yebis Engineering <onboarding@resend.dev>"
# After adding your custom domain in Resend: "Yebis Engineering <inquiries@yebisengineering.pro.et>"
RESEND_FROM_EMAIL="Yebis Engineering <onboarding@resend.dev>"

# Destination Email for Commercial Inquiries & Project Briefs
# Submissions from /contact, /start-a-project, and the homepage form are delivered here.
CONTACT_NOTIFICATION_EMAIL="inquiries@yebisengineering.pro.et"

# ------------------------------------------------------------------------------
# 2. ALTERNATIVE: SMTP CONFIGURATION (NODEMAILER)
# ------------------------------------------------------------------------------
# If you prefer standard SMTP (e.g. Google Workspace, Microsoft 365, Amazon SES, cPanel)
# instead of Resend, configure these:
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="your-email@domain.com"
# SMTP_PASSWORD="your-app-password"
# SMTP_FROM="Yebis Engineering <inquiries@yebisengineering.pro.et>"

# ------------------------------------------------------------------------------
# 3. OPTIONAL: INSTANT TEAM WEBHOOK ALERTS (DISCORD / SLACK / TELEGRAM)
# ------------------------------------------------------------------------------
# When a client submits an RFP or contact inquiry, a summary card is also pushed here:
# NOTIFICATION_WEBHOOK_URL="https://discord.com/api/webhooks/..."
